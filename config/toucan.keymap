#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

// Key position groups for positional home-row mods.
// Hold only triggers when the next key is on the opposite hand (or a thumb),
// which suppresses misfires during same-hand alpha rolls.
#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35
#define THUMBS 36 37 38 39 40 41

/ {
    behaviors {
        // Left-hand home-row mod: GUI/ALT/CTRL/SHIFT under A R S T
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };
        // Right-hand home-row mod: SHIFT/CTRL/ALT/GUI under N E I O
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <NAV SYM>;
            then-layer = <ADJ>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp TAB     &kp Q       &kp W       &kp F        &kp P        &kp B      &kp J  &kp L         &kp U         &kp Y       &kp SEMI &kp DEL
                &kp BSPC    &hml LGUI A &hml LALT R &hml LCTRL S &hml LSHFT T &kp G      &kp M  &hmr RSHFT N  &hmr RCTRL E  &hmr RALT I &hmr RGUI O &kp SQT
                &kp LSHFT   &kp Z       &kp X       &kp C        &kp D        &kp V      &kp K  &kp H         &kp COMMA     &kp DOT     &kp FSLH &kp ESC
                                                    &kp LGUI     &mo NAV      &kp RET   &kp SPACE &mo SYM     &kp BSPC
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &kp GRAVE  &kp N1   &kp N2   &kp N3    &kp N4    &kp N5     &kp N6   &kp N7    &kp N8    &kp N9    &kp N0   &kp BSPC
                &trans     &kp LGUI &kp LALT &kp LCTRL &kp LSHFT &trans     &kp LEFT &kp DOWN  &kp UP    &kp RIGHT &kp SEMI &kp SQT
                &kp LSHFT  &trans   &trans   &trans    &trans    &trans     &kp HOME &kp PG_DN &kp PG_UP &kp END   &kp FSLH &kp ESC
                                             &kp LGUI  &trans    &kp RET   &kp SPACE  &mo SYM  &trans
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &kp TAB    &kp EXCL &kp AT   &kp HASH  &kp DLLR  &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
                &trans     &kp LGUI &kp LALT &kp LCTRL &kp LSHFT &kp GRAVE   &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &kp SQT
                &kp LSHFT  &trans   &trans   &trans    &trans    &kp TILDE   &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE &kp ESC
                                            &kp LGUI  &mo NAV   &kp RET   &kp SPACE   &trans    &trans
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
                &bt BT_CLR &kp F1         &kp F2       &kp F3       &kp F4       &kp F5         &kp F6      &kp F7       &kp F8       &kp F9     &kp F10   &kp F11
                &trans     &bt BT_SEL 0   &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp C_VOL_DN &kp C_MUTE  &kp C_VOL_UP &kp C_PREV &kp C_NEXT &kp F12
                &kp LSHFT  &studio_unlock &trans       &trans       &trans       &bootloader    &kp C_PP    &kp C_BRI_DN &kp C_BRI_UP &trans     &trans    &bootloader
                                                       &kp LGUI     &trans       &kp RET      &kp SPACE     &trans       &trans
            >;
        };

        extra_1 {
                status = "reserved";
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};
